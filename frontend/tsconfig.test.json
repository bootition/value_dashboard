{
  /* 测试代码类型门禁（2026-11-19 T2 审计 §1 建议落点）。
   *
   * 缺口：tests/*.test.ts 走 `node --experimental-strip-types --test`（只剥类型、不查类型），
   * vitest 只覆盖 tests/component/**，vue-tsc(tsconfig.app.json) 只扫 src/**，
   * 于是测试里传了三个月前就删掉的入参（screening-quality.sortField、结果面板 sort prop）
   * 都没人发现 —— 传不存在的入参在运行时是 no-op，测试照样绿。
   *
   * 本配置把 src/** + tests/** 一起纳入检查。用 vue-tsc 而不是 tsc：
   * tests/component/** 直接 import `.vue` 单文件组件，tsc 解析不了 .vue。
   *
   * 尾巴（历史遗留类型错误，**非**本次死入参导致，未修，见 exclude）：
   * 首次开门禁共报 49 条，其中 27 条在本文件修复/已删（16 条 sortField 死入参 +
   * 11 条 ScreeningRuleCondition/ScreeningRuleNode 缺 id 的 fixture 形状问题，见 screening-quality.test.ts）；
   * 余下 22 条分布在 7 个文件、与本次无关，整文件 exclude 掉并在此登记。修它们属于各自的 fixture 口径问题，
   * 不在"删死入参"的租约里；逐个修风险大于收益，先挡在门外并登记，等各自负责人收口。
   */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "tests/**/*.ts"],
  "exclude": [
    /* 3 条：IndicatorTrust fixture 缺 masked_fields（字段后来新增，测试没跟） */
    "tests/indicator-trust.test.ts",
    /* 2 条：StockInfo 无 sw_level1；GrowthIndicators 缺 deducted_profit_cagr3/5 */
    "tests/stock-detail.test.ts",
    /* 4 条：RESULT_ROWS 不满足 ScreeningResult 必填列；ruleTree 条件缺 id */
    "tests/component/screening-persist-flow.test.ts",
    /* 4 条：ScreeningRuleNode/ScreeningRuleCondition 缺 id；direction 'desc' 不在字面量类型里 */
    "tests/component/screening-rule-clone.test.ts",
    /* 3 条：axios 实例被当成 AxiosStatic 传进 mock 辅助函数 */
    "tests/component/write-token.test.ts",
    /* 4 条：2 条未使用变量（noUnusedLocals）+ 1 条元组解构 + 1 条竖排数组谓词 */
    "tests/component/stock-detail-flow.test.ts",
    /* 2 条：未使用变量（noUnusedLocals） */
    "tests/component/etf-strategy-panel.test.ts"
  ]
}
